generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserStatus { ACTIVE SUSPENDED BANNED DELETED }
enum UserRole { PATIENT DOCTOR MODERATOR SUPPORT FINANCE ADMIN SUPER_ADMIN }
enum DoctorStatus { PENDING UNDER_REVIEW VERIFIED REJECTED SUSPENDED BANNED }
enum AppointmentStatus { PENDING CONFIRMED IN_PROGRESS COMPLETED CANCELLED REFUNDED DISPUTED NO_SHOW }
enum PaymentStatus { PENDING SUCCEEDED FAILED REFUNDED PARTIALLY_REFUNDED DISPUTED }

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  phone String? @unique
  passwordHash String
  status UserStatus @default(ACTIVE)
  mfaEnabled Boolean @default(false)
  mfaSecretEncrypted String?
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roles UserRoleAssignment[]
  patient PatientProfile?
  doctor DoctorProfile?
  appointmentsAsPatient Appointment[] @relation("PatientAppointments")
  appointmentsAsDoctor Appointment[] @relation("DoctorAppointments")
  transactions Transaction[]
  auditEvents AuditLog[] @relation("AuditActor")
  refreshSessions RefreshSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  @@index([status, createdAt])
}

model UserRoleAssignment {
  userId String @db.Uuid
  role UserRole
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([userId,role])
  @@index([role])
}

model RefreshSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt DateTime?
  revokeReason String?
  replacedBySessionId String? @db.Uuid
  userAgent String?
  ipAddress String?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId, revokedAt, expiresAt])
}

model EmailVerificationToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId, expiresAt])
}

model PatientProfile {
  userId String @id @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  firstName String?
  lastName String?
  dateOfBirth DateTime?
  timezone String @default("UTC")
  preferredLanguage String @default("en")
  countryCode String?
  city String?
}

model DoctorProfile {
  userId String @id @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  displayName String?
  legalName String?
  specialtyId String?
  bio String?
  gender String?
  countryCode String?
  city String?
  languages String[]
  status DoctorStatus @default(PENDING)
  ratingAvg Decimal @default(0) @db.Decimal(4,2)
  ratingCount Int @default(0)
  verifiedAt DateTime?
  verifications DoctorVerification[]
  services DoctorService[]
}

model DoctorVerification {
  id String @id @default(uuid()) @db.Uuid
  doctorId String @db.Uuid
  status DoctorStatus @default(PENDING)
  licenseNumber String?
  licensingAuthority String?
  graduationYear Int?
  university String?
  reviewedBy String? @db.Uuid
  reviewedAt DateTime?
  rejectionReason String?
  createdAt DateTime @default(now())
  doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade)
  documents VerificationDocument[]
  @@index([doctorId,status])
}

model VerificationDocument {
  id String @id @default(uuid()) @db.Uuid
  verificationId String @db.Uuid
  type String
  objectKey String
  sha256 String?
  createdAt DateTime @default(now())
  verification DoctorVerification @relation(fields:[verificationId],references:[id],onDelete:Cascade)
}

model DoctorService {
  id String @id @default(uuid()) @db.Uuid
  doctorId String @db.Uuid
  name String
  consultationType String
  durationMinutes Int
  price Decimal @db.Decimal(12,2)
  currency String
  active Boolean @default(true)
  doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade)
  appointments Appointment[]
  @@index([doctorId,active])
}

model Appointment {
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  doctorId String @db.Uuid
  serviceId String @db.Uuid
  startsAt DateTime
  endsAt DateTime
  patientTimezone String
  status AppointmentStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient User @relation("PatientAppointments",fields:[patientId],references:[id])
  doctor User @relation("DoctorAppointments",fields:[doctorId],references:[id])
  service DoctorService @relation(fields:[serviceId],references:[id])
  transactions Transaction[]
  @@index([doctorId,startsAt,status])
  @@index([patientId,startsAt,status])
}

model Transaction {
  id String @id @default(uuid()) @db.Uuid
  appointmentId String? @db.Uuid
  userId String @db.Uuid
  provider String
  providerTransactionId String?
  status PaymentStatus @default(PENDING)
  currency String
  consultationAmount Decimal @db.Decimal(12,2)
  patientPlatformFee Decimal @db.Decimal(12,2) @default(0)
  doctorPlatformFee Decimal @db.Decimal(12,2) @default(0)
  taxAmount Decimal @db.Decimal(12,2) @default(0)
  processingFee Decimal @db.Decimal(12,2) @default(0)
  refundAmount Decimal @db.Decimal(12,2) @default(0)
  doctorNet Decimal @db.Decimal(12,2) @default(0)
  platformRevenue Decimal @db.Decimal(12,2) @default(0)
  feeSnapshot Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appointment Appointment? @relation(fields:[appointmentId],references:[id])
  user User @relation(fields:[userId],references:[id])
  @@index([providerTransactionId])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorUserId String? @db.Uuid
  action String
  resourceType String
  resourceId String?
  metadata Json?
  createdAt DateTime @default(now())
  actor User? @relation("AuditActor",fields:[actorUserId],references:[id])
  @@index([actorUserId,createdAt])
}