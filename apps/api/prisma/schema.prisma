generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}
enum UserRole {
  PATIENT
  DOCTOR
  MODERATOR
  SUPPORT
  FINANCE
  ADMIN
  SUPER_ADMIN
}
enum DoctorStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  BANNED
}
enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
  NO_SHOW
}
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}
enum VerificationDocumentType {
  GOVERNMENT_ID
  LICENSE_PROOF
  DEGREE
  CERTIFICATE
  OTHER
}
enum LicenseStatus {
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
  SUSPENDED
}
enum AvailabilityExceptionType {
  HOLIDAY
  LEAVE
  BLOCKED
}
enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  CANCELLED
  EXPIRED
}
enum ConversationStatus {
  ACTIVE
  BLOCKED
  ARCHIVED
}
enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  VOICE_SYSTEM
}
enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}
enum SubscriptionTier {
  FREE
  PREMIUM
  PRO
}
enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}
enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}
enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}
enum VideoProvider {
  DAILY
  TWILIO
  AGORA
  WEBRTC
}
enum VideoSessionStatus {
  CREATED
  WAITING
  ACTIVE
  ENDED
  FAILED
}
enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}
enum HealthArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
model User {
 id String @id @default(uuid()) @db.Uuid
 email String @unique
 phone String? @unique
 passwordHash String
 status UserStatus @default(ACTIVE)
 mfaEnabled Boolean @default(false)
 mfaSecretEncrypted String?
 emailVerifiedAt DateTime?
 stripeCustomerId String? @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 roles UserRoleAssignment[]
 patient PatientProfile?
 doctor DoctorProfile?
 appointmentsAsPatient Appointment[] @relation("PatientAppointments")
 appointmentsAsDoctor Appointment[] @relation("DoctorAppointments")
 prescriptionsAsPatient Prescription[] @relation("PatientPrescriptions")
 prescriptionsAsDoctor Prescription[] @relation("DoctorPrescriptions")
 transactions Transaction[]
 subscriptions Subscription[]
 reviews Review[] @relation("PatientReviews")
 notifications Notification[]
 disputesOpened Dispute[]

 auditEvents AuditLog[] @relation("AuditActor")
 refreshSessions RefreshSession[]
 emailVerificationTokens EmailVerificationToken[]
 passwordResetTokens PasswordResetToken[]
 conversationsAsPatient Conversation[] @relation("ConversationPatient")
 conversationsAsDoctor Conversation[] @relation("ConversationDoctor")
 sentMessages Message[] @relation("MessageSender")
 documentsOwned MedicalDocument[] @relation("DocumentOwner")
 documentsUploaded MedicalDocument[] @relation("DocumentUploader")
 documentsShared MedicalDocument[] @relation("DocumentDoctor")
 messageReads MessageRead[]
 reportsFiled Report[] @relation("ReportReporter")
 reportsAgainst Report[] @relation("ReportTarget")
}
model UserRoleAssignment {
 userId String @db.Uuid
 role UserRole
 user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@id([userId,role]) @@index([role])
}
model RefreshSession {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 tokenHash String @unique
 expiresAt DateTime
 createdAt DateTime @default(now())
 lastUsedAt DateTime?
 revokedAt DateTime?
 revokeReason String?
 replacedBySessionId String? @db.Uuid
 userAgent String?
 ipAddress String?
 user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,revokedAt,expiresAt])
}
model EmailVerificationToken {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 tokenHash String @unique
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,expiresAt])
}
model PasswordResetToken {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 tokenHash String @unique
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,expiresAt])
}
model PatientProfile {
 userId String @id @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 firstName String?
 lastName String?
 dateOfBirth DateTime?
 timezone String @default("UTC")
 preferredLanguage String @default("en")
 countryCode String?
 cityId String? @db.Uuid
 city City? @relation(fields:[cityId],references:[id])
 healthProfile HealthProfile?
 familyMembers FamilyMember[]
}
model HealthProfile {
 id String @id @default(uuid()) @db.Uuid
 userId String @unique @db.Uuid
 bloodType String?
 allergies Json?
 chronicConditions Json?
 medications Json?
 emergencyContact Json?
 notes String?
 updatedAt DateTime @updatedAt
 patient PatientProfile @relation(fields:[userId],references:[userId],onDelete:Cascade)
}
model FamilyMember {
 id String @id @default(uuid()) @db.Uuid
 patientId String @db.Uuid
 firstName String
 lastName String?
 relationship String
 dateOfBirth DateTime?
 notes String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 patient PatientProfile @relation(fields:[patientId],references:[userId],onDelete:Cascade) @@index([patientId])
}
model Specialty {
 id String @id @default(uuid()) @db.Uuid
 code String @unique
 name String
 description String?
 active Boolean @default(true)
 doctors DoctorProfile[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt @@index([active,name])
}
model Country {
 id String @id @default(uuid()) @db.Uuid
 code String @unique
 name String
 active Boolean @default(true)
 cities City[]
 doctors DoctorProfile[]
 licenses MedicalLicense[] @@index([active,name])
}
model City {
 id String @id @default(uuid()) @db.Uuid
 countryId String @db.Uuid
 name String
 active Boolean @default(true)
 country Country @relation(fields:[countryId],references:[id],onDelete:Restrict)
 doctors DoctorProfile[]
 patients PatientProfile[] @@unique([countryId,name]) @@index([countryId,active,name])
}
model Language {
 id String @id @default(uuid()) @db.Uuid
 code String @unique
 name String
 nativeName String?
 active Boolean @default(true)
 doctorLanguages DoctorLanguage[] @@index([active,name])
}
model DoctorProfile {
 userId String @id @db.Uuid user User @relation(fields:[userId],references:[id],onDelete:Cascade) displayName String? legalName String? specialtyId String? specialty Specialty? @relation(fields:[specialtyId],references:[id],onDelete:SetNull) bio String? gender String? countryId String? @db.Uuid country Country? @relation(fields:[countryId],references:[id],onDelete:SetNull) cityId String? @db.Uuid city City? @relation(fields:[cityId],references:[id],onDelete:SetNull) timezone String @default("UTC") status DoctorStatus @default(PENDING) ratingAvg Decimal @default(0) @db.Decimal(4,2) ratingCount Int @default(0) verifiedAt DateTime? stripeAccountId String? @unique stripeOnboardingComplete Boolean @default(false)
 verifications DoctorVerification[] licenses MedicalLicense[] languages DoctorLanguage[] services DoctorService[] availabilities Availability[] availabilityExceptions AvailabilityException[] appointments Appointment[] waitlist Waitlist[] payouts DoctorPayout[]
 reviewsReceived Review[]
 @@index([status,specialtyId,countryId,cityId]) @@index([status,ratingAvg])
}
model DoctorLanguage {
 doctorId String @db.Uuid
 languageId String @db.Uuid
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade)
 language Language @relation(fields:[languageId],references:[id],onDelete:Restrict) @@id([doctorId,languageId]) @@index([languageId,doctorId])
}
model MedicalLicense {
 id String @id @default(uuid())
 doctorId String @db.Uuid
 licenseNumber String
 licensingAuthority String
 countryId String? @db.Uuid
 issuedAt DateTime?
 expiresAt DateTime?
 status LicenseStatus @default(PENDING)
 proofObjectKey String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade)
 country Country? @relation(fields:[countryId],references:[id],onDelete:SetNull) @@unique([licensingAuthority,licenseNumber]) @@index([doctorId,status])
}
model DoctorVerification {
 id String @id @default(uuid()) @db.Uuid
 doctorId String @db.Uuid
 status DoctorStatus @default(PENDING)
 legalName String?
 licenseNumber String?
 licensingAuthority String?
 graduationYear Int?
 university String?
 reviewedBy String? @db.Uuid
 reviewedAt DateTime?
 rejectionReason String?
 createdAt DateTime @default(now())
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade)
 documents VerificationDocument[] @@index([doctorId,status]) @@index([status,createdAt])
}
model VerificationDocument {
 id String @id @default(uuid()) @db.Uuid
 verificationId String @db.Uuid
 type VerificationDocumentType
 objectKey String
 sha256 String?
 createdAt DateTime @default(now())
 verification DoctorVerification @relation(fields:[verificationId],references:[id],onDelete:Cascade)
}
model DoctorService {
 id String @id @default(uuid())
 doctorId String @db.Uuid
 name String
 consultationType String
 durationMinutes Int
 price Decimal @db.Decimal(12,2)
 currency String
 bufferBeforeMinutes Int @default(0)
 bufferAfterMinutes Int @default(0)
 minimumNoticeMinutes Int @default(60)
 cancellationWindowMinutes Int @default(1440)
 active Boolean @default(true)
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade)
 appointments Appointment[] @@index([doctorId,active])
}
model Availability {
 id String @id @default(uuid())
 doctorId String @db.Uuid
 dayOfWeek Int
 startLocal String
 endLocal String
 timezone String?
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade) @@index([doctorId,dayOfWeek,active])
}
model AvailabilityException {
 id String @id @default(uuid())
 doctorId String @db.Uuid
 type AvailabilityExceptionType
 startsAt DateTime
 endsAt DateTime
 allDay Boolean @default(true)
 reason String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade) @@index([doctorId,startsAt,endsAt])
}
model Prescription {
 id String @id @default(uuid()) @db.Uuid
 appointmentId String @db.Uuid
 patientId String @db.Uuid
 doctorId String @db.Uuid
 medication String
 dosage String
 instructions String?
 issuedAt DateTime @default(now())
 expiresAt DateTime?
 appointment Appointment @relation(fields:[appointmentId],references:[id],onDelete:Restrict)
 patient User @relation("PatientPrescriptions",fields:[patientId],references:[id],onDelete:Restrict)
 doctor User @relation("DoctorPrescriptions",fields:[doctorId],references:[id],onDelete:Restrict) @@index([patientId,issuedAt]) @@index([doctorId,issuedAt])
}
model Appointment { id String @id @default(uuid()) patientId String @db.Uuid doctorId String @db.Uuid serviceId String @db.Uuid startsAt DateTime endsAt DateTime patientTimezone String status AppointmentStatus @default(PENDING) idempotencyKey String? cancellationReason String? cancelledAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt patient User @relation("PatientAppointments",fields:[patientId],references:[id]) doctor User @relation("DoctorAppointments",fields:[doctorId],references:[id]) doctorProfile DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Restrict) service DoctorService @relation(fields:[serviceId],references:[id]) transactions Transaction[] conversation Conversation? messages Message[] prescriptions Prescription[] review Review?
 videoSession VideoSession? @@unique([patientId,idempotencyKey]) @@index([doctorId,startsAt,status]) @@index([doctorId,endsAt,status]) @@index([patientId,startsAt,status]) }
model Waitlist {
 id String @id @default(uuid())
 doctorId String @db.Uuid
 patientId String @db.Uuid
 serviceId String @db.Uuid
 preferredStartsAt DateTime?
 preferredEndsAt DateTime?
 timezone String
 status WaitlistStatus @default(WAITING)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 patient User @relation(fields:[patientId],references:[id],onDelete:Cascade)
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade)
 service DoctorService @relation(fields:[serviceId],references:[id],onDelete:Restrict) @@index([doctorId,status,createdAt]) @@index([patientId,status])
}
model PlatformFeeConfig {
 id String @id @default(uuid()) @db.Uuid
 name String @unique
 patientPercent Decimal @db.Decimal(5,2)
 doctorPercent Decimal @db.Decimal(5,2)
 monthlyDoctorPercent Decimal @db.Decimal(5,2)
 active Boolean @default(true)
 effectiveFrom DateTime @default(now())
 createdAt DateTime @default(now())
}
model Transaction { id String @id @default(uuid()) @db.Uuid appointmentId String? @db.Uuid userId String @db.Uuid provider String providerTransactionId String? providerClientSecret String? providerFeeId String? status PaymentStatus @default(PENDING) currency String consultationAmount Decimal @db.Decimal(12,2) patientPlatformFee Decimal @db.Decimal(12,2) @default(0) doctorPlatformFee Decimal @db.Decimal(12,2) @default(0) taxAmount Decimal @db.Decimal(12,2) @default(0) processingFee Decimal @db.Decimal(12,2) @default(0) refundAmount Decimal @db.Decimal(12,2) @default(0) doctorNet Decimal @db.Decimal(12,2) @default(0) platformRevenue Decimal @db.Decimal(12,2) @default(0) feeSnapshot Json createdAt DateTime @default(now()) updatedAt DateTime @updatedAt appointment Appointment? @relation(fields:[appointmentId],references:[id]) user User @relation(fields:[userId],references:[id]) payout DoctorPayout?\n
 disputes Dispute[] @@index([providerTransactionId]) @@index([appointmentId,status]) }
model PaymentWebhookEvent {
 id String @id @default(uuid()) @db.Uuid
 provider String
 eventId String
 receivedAt DateTime @default(now())
 processedAt DateTime?
 status String @default("RECEIVED")
 payload Json? @@unique([provider,eventId]) @@index([provider,receivedAt])
}
model DoctorPayout {
 id String @id @default(uuid()) @db.Uuid
 doctorId String @db.Uuid
 transactionId String @db.Uuid
 provider String
 providerPayoutId String?
 amount Decimal @db.Decimal(12,2)
 currency String
 status String @default("PENDING")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Restrict)
 transaction Transaction @relation(fields:[transactionId],references:[id],onDelete:Restrict) @@unique([transactionId]) @@index([doctorId,status])
}
model Conversation { id String @id @default(uuid()) @db.Uuid patientId String @db.Uuid doctorId String @db.Uuid appointmentId String? @db.Uuid status ConversationStatus @default(ACTIVE) lastMessageAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt patient User @relation("ConversationPatient",fields:[patientId],references:[id],onDelete:Cascade) doctor User @relation("ConversationDoctor",fields:[doctorId],references:[id],onDelete:Cascade) appointment Appointment? @relation(fields:[appointmentId],references:[id],onDelete:SetNull) messages Message[]
 reports Report[]
 @@unique([patientId,doctorId]) @@index([patientId,lastMessageAt]) @@index([doctorId,lastMessageAt]) }
model Message { id String @id @default(uuid()) @db.Uuid conversationId String @db.Uuid senderId String @db.Uuid appointmentId String? @db.Uuid type MessageType encryptedContent String? nonce String? authTag String? replyToId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade) sender User @relation("MessageSender",fields:[senderId],references:[id],onDelete:Restrict) appointment Appointment? @relation(fields:[appointmentId],references:[id],onDelete:SetNull) replyTo Message? @relation("MessageReplies",fields:[replyToId],references:[id],onDelete:SetNull) replies Message[] @relation("MessageReplies") attachments MessageAttachment[] reads MessageRead[]
 reports Report[] @@index([conversationId,createdAt]) @@index([senderId,createdAt]) }
model MessageAttachment {
 id String @id @default(uuid()) @db.Uuid
 messageId String @db.Uuid
 documentId String @db.Uuid
 message Message @relation(fields:[messageId],references:[id],onDelete:Cascade)
 document MedicalDocument @relation(fields:[documentId],references:[id],onDelete:Restrict) @@unique([messageId,documentId])
}
model MessageRead {
 messageId String @db.Uuid
 userId String @db.Uuid
 readAt DateTime @default(now())
 message Message @relation(fields:[messageId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@id([messageId,userId]) @@index([userId,readAt])
}
model MedicalDocument {
 id String @id @default(uuid()) @db.Uuid
 ownerId String @db.Uuid
 uploaderId String @db.Uuid
 doctorId String? @db.Uuid
 objectKey String @unique
 originalName String
 mimeType String
 sizeBytes BigInt
 sha256 String?
 encryptionKeyRef String?
 createdAt DateTime @default(now())
 deletedAt DateTime?
 owner User @relation("DocumentOwner",fields:[ownerId],references:[id],onDelete:Cascade)
 uploader User @relation("DocumentUploader",fields:[uploaderId],references:[id],onDelete:Restrict)
 doctor User? @relation("DocumentDoctor",fields:[doctorId],references:[id],onDelete:SetNull)
 attachments MessageAttachment[] @@index([ownerId,createdAt]) @@index([doctorId,createdAt])
}
model Report {
 id String @id @default(uuid()) @db.Uuid
 reporterId String @db.Uuid
 targetUserId String? @db.Uuid
 conversationId String? @db.Uuid
 messageId String? @db.Uuid
 reason String
 details String?
 status ReportStatus @default(OPEN)
 createdAt DateTime @default(now())
 resolvedAt DateTime?
 reporter User @relation("ReportReporter",fields:[reporterId],references:[id],onDelete:Cascade)
 targetUser User? @relation("ReportTarget",fields:[targetUserId],references:[id],onDelete:SetNull)
 conversation Conversation? @relation(fields:[conversationId],references:[id],onDelete:SetNull)
 message Message? @relation(fields:[messageId],references:[id],onDelete:SetNull) @@index([status,createdAt]) @@index([reporterId,createdAt])
}
}
model SubscriptionPlan {
 id String @id @default(uuid()) @db.Uuid
 code String @unique
 name String
 tier SubscriptionTier
 price Decimal @db.Decimal(12,2)
 currency String
 interval String
 features Json
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 subscriptions Subscription[]
}
model Subscription {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 planId String @db.Uuid
 provider String?
 providerSubscriptionId String?
 status SubscriptionStatus @default(ACTIVE)
 startsAt DateTime @default(now())
 endsAt DateTime?
 cancelAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 plan SubscriptionPlan @relation(fields:[planId],references:[id],onDelete:Restrict) @@index([userId,status])
}
model Review {
 id String @id @default(uuid()) @db.Uuid
 appointmentId String @db.Uuid
 doctorId String @db.Uuid
 patientId String @db.Uuid
 rating Int
 comment String?
 status ReviewStatus @default(PUBLISHED)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 appointment Appointment @relation(fields:[appointmentId],references:[id],onDelete:Restrict)
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Restrict)
 patient User @relation("PatientReviews",fields:[patientId],references:[id],onDelete:Restrict) @@unique([appointmentId]) @@index([doctorId,status,createdAt])
}
model Dispute {
 id String @id @default(uuid()) @db.Uuid
 transactionId String @db.Uuid
 openedById String @db.Uuid
 reason String
 details String?
 status DisputeStatus @default(OPEN)
 resolution String?
 createdAt DateTime @default(now())
 resolvedAt DateTime?
 transaction Transaction @relation(fields:[transactionId],references:[id],onDelete:Restrict)
 openedBy User @relation(fields:[openedById],references:[id],onDelete:Restrict) @@index([status,createdAt]) @@index([openedById,createdAt])
}
model Notification {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 channel NotificationChannel
 title String
 body String
 data Json?
 status NotificationStatus @default(QUEUED)
 sentAt DateTime?
 readAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,status,createdAt])
}
model VideoSession {
 id String @id @default(uuid()) @db.Uuid
 appointmentId String @unique @db.Uuid
 provider VideoProvider
 status VideoSessionStatus @default(CREATED)
 roomName String @unique
 providerSessionId String?
 joinTokenExpiry DateTime?
 startedAt DateTime?
 endedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 appointment Appointment @relation(fields:[appointmentId],references:[id],onDelete:Restrict)
}
model Ad {
 id String @id @default(uuid()) @db.Uuid
 title String
 body String?
 imageUrl String?
 targetUrl String
 status AdStatus @default(DRAFT)
 startsAt DateTime?
 endsAt DateTime?
 maxImpressions Int?
 impressions Int @default(0)
 clicks Int @default(0)
 premiumExcluded Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt @@index([status,startsAt,endsAt])
}
model HealthArticle {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 title String
 summary String?
 body String
 authorName String?
 language String @default("en")
 status HealthArticleStatus @default(DRAFT)
 publishedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt @@index([language,status,publishedAt])
}
model AuditLog {
 id String @id @default(uuid()) @db.Uuid
 actorUserId String? @db.Uuid
 action String
 resourceType String
 resourceId String?
 metadata Json?
 createdAt DateTime @default(now())
 actor User? @relation("AuditActor",fields:[actorUserId],references:[id]) @@index([actorUserId,createdAt])
}
