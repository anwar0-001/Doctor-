generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum UserStatus { ACTIVE SUSPENDED BANNED DELETED }
enum UserRole { PATIENT DOCTOR MODERATOR SUPPORT FINANCE ADMIN SUPER_ADMIN }
enum DoctorStatus { PENDING UNDER_REVIEW VERIFIED REJECTED SUSPENDED BANNED }
enum AppointmentStatus { PENDING CONFIRMED IN_PROGRESS COMPLETED CANCELLED REFUNDED DISPUTED NO_SHOW }
enum PaymentStatus { PENDING SUCCEEDED FAILED REFUNDED PARTIALLY_REFUNDED DISPUTED }
enum VerificationDocumentType { GOVERNMENT_ID LICENSE_PROOF DEGREE CERTIFICATE OTHER }
enum LicenseStatus { PENDING VERIFIED EXPIRED REJECTED SUSPENDED }

model User {
 id String @id @default(uuid()) @db.Uuid
 email String @unique
 phone String? @unique
 passwordHash String
 status UserStatus @default(ACTIVE)
 mfaEnabled Boolean @default(false)
 mfaSecretEncrypted String?
 emailVerifiedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 roles UserRoleAssignment[]
 patient PatientProfile?
 doctor DoctorProfile?
 appointmentsAsPatient Appointment[] @relation("PatientAppointments")
 appointmentsAsDoctor Appointment[] @relation("DoctorAppointments")
 transactions Transaction[]
 auditEvents AuditLog[] @relation("AuditActor")
 refreshSessions RefreshSession[]
 emailVerificationTokens EmailVerificationToken[]
 passwordResetTokens PasswordResetToken[]
 @@index([status,createdAt])
}
model UserRoleAssignment {
 userId String @db.Uuid
 role UserRole
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@id([userId,role])
 @@index([role])
}
model RefreshSession {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 tokenHash String @unique
 expiresAt DateTime
 createdAt DateTime @default(now())
 lastUsedAt DateTime?
 revokedAt DateTime?
 revokeReason String?
 replacedBySessionId String? @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId,revokedAt,expiresAt])
}
model EmailVerificationToken {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 tokenHash String @unique
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId,expiresAt])
}
model PasswordResetToken {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 tokenHash String @unique
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId,expiresAt])
}
model PatientProfile {
 userId String @id @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 firstName String?
 lastName String?
 dateOfBirth DateTime?
 timezone String @default("UTC")
 preferredLanguage String @default("en")
 countryCode String?
 cityId String? @db.Uuid
 city City? @relation(fields:[cityId],references:[id])
}
model Specialty {
 id String @id @default(uuid()) @db.Uuid
 code String @unique
 name String
 description String?
 active Boolean @default(true)
 doctors DoctorProfile[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([active,name])
}
model Country {
 id String @id @default(uuid()) @db.Uuid
 code String @unique
 name String
 active Boolean @default(true)
 cities City[]
 doctors DoctorProfile[]
 licenses MedicalLicense[]
 @@index([active,name])
}
model City {
 id String @id @default(uuid()) @db.Uuid
 countryId String @db.Uuid
 name String
 active Boolean @default(true)
 country Country @relation(fields:[countryId],references:[id],onDelete:Restrict)
 doctors DoctorProfile[]
 patients PatientProfile[]
 @@unique([countryId,name])
 @@index([countryId,active,name])
}
model Language {
 id String @id @default(uuid()) @db.Uuid
 code String @unique
 name String
 nativeName String?
 active Boolean @default(true)
 doctorLanguages DoctorLanguage[]
 @@index([active,name])
}
model DoctorProfile {
 userId String @id @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 displayName String?
 legalName String?
 specialtyId String?
 specialty Specialty? @relation(fields:[specialtyId],references:[id],onDelete:SetNull)
 bio String?
 gender String?
 countryId String? @db.Uuid
 country Country? @relation(fields:[countryId],references:[id],onDelete:SetNull)
 cityId String? @db.Uuid
 city City? @relation(fields:[cityId],references:[id],onDelete:SetNull)
 timezone String @default("UTC")
 status DoctorStatus @default(PENDING)
 ratingAvg Decimal @default(0) @db.Decimal(4,2)
 ratingCount Int @default(0)
 verifiedAt DateTime?
 verifications DoctorVerification[]
 licenses MedicalLicense[]
 languages DoctorLanguage[]
 services DoctorService[]
 @@index([status,specialtyId,countryId,cityId])
 @@index([status,ratingAvg])
}
model DoctorLanguage {
 doctorId String @db.Uuid
 languageId String @db.Uuid
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade)
 language Language @relation(fields:[languageId],references:[id],onDelete:Restrict)
 @@id([doctorId,languageId])
 @@index([languageId,doctorId])
}
model MedicalLicense {
 id String @id @default(uuid()) @db.Uuid
 doctorId String @db.Uuid
 licenseNumber String
 licensingAuthority String
 countryId String? @db.Uuid
 issuedAt DateTime?
 expiresAt DateTime?
 status LicenseStatus @default(PENDING)
 proofObjectKey String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade)
 country Country? @relation(fields:[countryId],references:[id],onDelete:SetNull)
 @@unique([licensingAuthority,licenseNumber])
 @@index([doctorId,status])
}
model DoctorVerification {
 id String @id @default(uuid()) @db.Uuid
 doctorId String @db.Uuid
 status DoctorStatus @default(PENDING)
 legalName String?
 licenseNumber String?
 licensingAuthority String?
 graduationYear Int?
 university String?
 reviewedBy String? @db.Uuid
 reviewedAt DateTime?
 rejectionReason String?
 createdAt DateTime @default(now())
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade)
 documents VerificationDocument[]
 @@index([doctorId,status])
 @@index([status,createdAt])
}
model VerificationDocument {
 id String @id @default(uuid()) @db.Uuid
 verificationId String @db.Uuid
 type VerificationDocumentType
 objectKey String
 sha256 String?
 createdAt DateTime @default(now())
 verification DoctorVerification @relation(fields:[verificationId],references:[id],onDelete:Cascade)
}
model DoctorService {
 id String @id @default(uuid()) @db.Uuid
 doctorId String @db.Uuid
 name String
 consultationType String
 durationMinutes Int
 price Decimal @db.Decimal(12,2)
 currency String
 active Boolean @default(true)
 doctor DoctorProfile @relation(fields:[doctorId],references:[userId],onDelete:Cascade)
 appointments Appointment[]
 @@index([doctorId,active])
}
model Appointment {
 id String @id @default(uuid()) @db.Uuid
 patientId String @db.Uuid
 doctorId String @db.Uuid
 serviceId String @db.Uuid
 startsAt DateTime
 endsAt DateTime
 patientTimezone String
 status AppointmentStatus @default(PENDING)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 patient User @relation("PatientAppointments",fields:[patientId],references:[id])
 doctor User @relation("DoctorAppointments",fields:[doctorId],references:[id])
 service DoctorService @relation(fields:[serviceId],references:[id])
 transactions Transaction[]
 @@index([doctorId,startsAt,status])
 @@index([patientId,startsAt,status])
}
model Transaction {
 id String @id @default(uuid()) @db.Uuid
 appointmentId String? @db.Uuid
 userId String @db.Uuid
 provider String
 providerTransactionId String?
 status PaymentStatus @default(PENDING)
 currency String
 consultationAmount Decimal @db.Decimal(12,2)
 patientPlatformFee Decimal @db.Decimal(12,2) @default(0)
 doctorPlatformFee Decimal @db.Decimal(12,2) @default(0)
 taxAmount Decimal @db.Decimal(12,2) @default(0)
 processingFee Decimal @db.Decimal(12,2) @default(0)
 refundAmount Decimal @db.Decimal(12,2) @default(0)
 doctorNet Decimal @db.Decimal(12,2) @default(0)
 platformRevenue Decimal @db.Decimal(12,2) @default(0)
 feeSnapshot Json
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 appointment Appointment? @relation(fields:[appointmentId],references:[id])
 user User @relation(fields:[userId],references:[id])
 @@index([providerTransactionId])
}
model AuditLog {
 id String @id @default(uuid()) @db.Uuid
 actorUserId String? @db.Uuid
 action String
 resourceType String
 resourceId String?
 metadata Json?
 createdAt DateTime @default(now())
 actor User? @relation("AuditActor",fields:[actorUserId],references:[id])
 @@index([actorUserId,createdAt])
}